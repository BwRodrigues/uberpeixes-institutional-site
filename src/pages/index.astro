---
import "../styles/global.css";
import Arrow from "../components/Arrow.astro";
import Brand from "../components/Brand.astro";
import Aquarium from "../components/aquarium/Aquarium.astro";
import { Image } from "astro:assets";
import entrance from "../assets/entrada-uberpeixes.jpg";
const whatsapp = "https://wa.me/5534998910880";
const instagram = "https://www.instagram.com/uberpeixesornamentais/";
const maps = "https://maps.app.goo.gl/zRgtCTnjvL8xZGiH7";
const gallery = [
  {
    file: "equipe-loja.webp",
    width: 1600,
    height: 1200,
    title: "Uma paixão que aproxima",
    alt: "Grupo de pessoas reunido entre as prateleiras de produtos da Uberpeixes",
  },
  {
    file: "atendimento-loja.webp",
    width: 1200,
    height: 1600,
    title: "Atendimento de perto",
    alt: "Duas pessoas na loja, em frente às prateleiras de produtos para aquarismo",
  },
  {
    file: "visita-equipe.webp",
    width: 1600,
    height: 1200,
    title: "Encontros no nosso espaço",
    alt: "Grupo de pessoas em uma visita à loja, entre aquários de vidro e equipamentos",
  },
  {
    file: "estrutura-loja.webp",
    width: 900,
    height: 1600,
    title: "Nossa estrutura de tanques",
    alt: "Interior da loja com tanques, aquários e equipamentos de manutenção",
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Conheça a Uberpeixes Ornamentais. Converse pelo WhatsApp, acompanhe o Instagram e encontre a loja no Google Maps."
    />
    <meta name="theme-color" content="#45409b" />
    <title>Uberpeixes Ornamentais | Um universo para descobrir</title>
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/icons/official-v2/favicon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/official-v2/icon-32.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/official-v2/icon-180.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <Aquarium />
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <header class="header wrap">
      <a
        class="brand"
        href="#inicio"
        aria-label="Uberpeixes Ornamentais — início"
      >
        <Brand />
      </a>
      <nav aria-label="Navegação principal">
        <a href="#sobre">A loja</a>
        <a href="#galeria">Nosso universo</a>
        <a href="#visite">Visite</a>
      </nav>
      <a
        class="button button-small"
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        Vamos conversar{" "}
        <span aria-hidden="true">
          <Arrow />
        </span>
      </a>
    </header>
    <main id="conteudo">
      <section class="hero wrap" id="inicio" aria-labelledby="titulo">
        <div class="hero-copy">
          <p class="eyebrow">
            <span></span> UBERPEIXES ORNAMENTAIS
          </p>
          <h1 id="titulo">
            Seu mundo mais <em>colorido</em> começa aqui!
          </h1>
          <p class="intro">
            Peixes ornamentais, aquários, plantas e acessórios para transformar
            seus espaços em um pedacinho da natureza. Descubra o aquarismo com a
            Uberpeixes!
          </p>
          <a
            class="button"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Fale com nossa equipe{" "}
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
          <a class="text-link" href="#sobre">
            Conheça a loja <span aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="hero-visual">
          <span class="bubble bubble-one" aria-hidden="true"></span>
          <span class="bubble bubble-two" aria-hidden="true"></span>
          <span class="bubble bubble-three" aria-hidden="true"></span>
          <div class="hero-brand">
            <Brand decorative size={720} />
          </div>
          <p>
            Um pedacinho da natureza.{" "}
            <strong>Um mundo de possibilidades.</strong>
          </p>
        </div>
        <div class="hero-bottom">
          <span>Natureza que inspira a olhar de perto.</span>
          <span aria-hidden="true">01 / DESCUBRA</span>
        </div>
      </section>
      <section
        class="about section wrap"
        id="sobre"
        aria-labelledby="sobre-titulo"
      >
        <div>
          <p class="eyebrow">01 — A LOJA</p>
          <h2 id="sobre-titulo">
            Mais que uma loja, uma <em>paixão pelo aquarismo!</em>
          </h2>
        </div>
        <div class="about-copy">
          <p class="large-copy">
            Na Uberpeixes Ornamentais, ajudamos iniciantes e apaixonados por
            aquários a encontrar peixes, produtos e orientações para cuidar de
            seu mundo aquático. Nosso espaço reúne variedade, atendimento
            próximo e muita paixão pelo aquarismo.
          </p>
          <a
            class="underlined"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Tire suas dúvidas pelo WhatsApp{" "}
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
        </div>
      </section>
      <section
        class="gallery-section"
        id="galeria"
        aria-labelledby="galeria-titulo"
      >
        <div class="wrap section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">02 — NOSSO UNIVERSO</p>
              <h2 id="galeria-titulo">
                Um mergulho no <em>nosso universo!</em>
              </h2>
            </div>
            <a
              class="underlined"
              href={instagram}
              target="_blank"
              rel="noopener noreferrer"
            >
              Acompanhe no Instagram <Arrow />
            </a>
          </div>
          <div class="gallery">
            {gallery.map((photo) => (
              <figure class="gallery-card">
                <img
                  src={`/images/${photo.file}`}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{photo.title}</figcaption>
              </figure>
            ))}
          </div>
          <p class="gallery-note">
            Acompanhe mais do nosso dia a dia em{" "}
            <a href={instagram} target="_blank" rel="noopener noreferrer">
              @uberpeixesornamentais <Arrow />
            </a>
          </p>
        </div>
      </section>
      <section
        class="section wrap visit"
        id="visite"
        aria-labelledby="visite-titulo"
      >
        <div>
          <p class="eyebrow">03 — ENCONTRE A GENTE</p>
          <h2 id="visite-titulo">
            Venha conhecer esse <em>mundo de perto!</em>
          </h2>
          <p>
            Fale com a loja para combinar sua visita e confirmar endereço e
            horário de atendimento.
          </p>
          <a
            class="button"
            href={maps}
            target="_blank"
            rel="noopener noreferrer"
          >
            Como chegar <Arrow />
          </a>
        </div>
        <figure class="visit-photo">
          <Image
            src={entrance}
            alt="Entrada da Uberpeixes Ornamentais, com bandeira azul e logomarca do peixe laranja"
            width={640}
            format="webp"
            loading="lazy"
          />
          <figcaption>A entrada da nossa loja. Esperamos você!</figcaption>
        </figure>
        <div class="contact-cards">
          <a href={instagram} target="_blank" rel="noopener noreferrer">
            <span>
              ACOMPANHE<b>Nosso Instagram</b>
              <small>@uberpeixesornamentais</small>
            </span>
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
          <a href={maps} target="_blank" rel="noopener noreferrer">
            <span>
              LOCALIZAÇÃO<b>Encontre a Uberpeixes</b>
              <small>Ver a loja no Google Maps</small>
            </span>
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
          <a href={maps} target="_blank" rel="noopener noreferrer">
            <span>
              AVALIAÇÕES REAIS<b>O que dizem no Google</b>
              <small>Abra o perfil e consulte a aba Avaliações</small>
            </span>
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
        </div>
      </section>
      <section class="closing">
        <div class="wrap">
          <p>Seu próximo aquário começa com uma conversa!</p>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer">
            Vamos conversar{" "}
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <div class="brand footer-brand">
        <Brand loading="lazy" />
      </div>
      <p>Uberpeixes Ornamentais</p>
      <p>Desenvolvido por Brendow Rodrigues</p>
      <button
        type="button"
        class="aquarium-toggle"
        data-aquarium-toggle
        aria-pressed="false"
        hidden
      >
        Pausar movimento do aquário
      </button>
    </footer>
  </body>
</html>
