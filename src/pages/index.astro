---
import "../styles/global.css";
import Arrow from "../components/Arrow.astro";
import Brand from "../components/Brand.astro";
import { Image } from "astro:assets";
import entrance from "../assets/entrada-uberpeixes.jpg";
const whatsapp = "https://wa.me/5534998910880";
const instagram = "https://www.instagram.com/uberpeixesornamentais/";
const maps = "https://maps.app.goo.gl/zRgtCTnjvL8xZGiH7";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Conheça a Uberpeixes Ornamentais. Converse pelo WhatsApp, acompanhe o Instagram e encontre a loja no Google Maps."
    />
    <meta name="theme-color" content="#45409b" />
    <title>Uberpeixes Ornamentais | Um universo para descobrir</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">
      Pular para o conteúdo
    </a>
    <header class="header wrap">
      <a
        class="brand"
        href="#inicio"
        aria-label="Uberpeixes Ornamentais — início"
      >
        <Brand />
      </a>
      <nav aria-label="Navegação principal">
        <a href="#sobre">A loja</a>
        <a href="#galeria">Nosso universo</a>
        <a href="#visite">Visite</a>
      </nav>
      <a
        class="button button-small"
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        Vamos conversar{" "}
        <span aria-hidden="true">
          <Arrow />
        </span>
      </a>
    </header>
    <main id="conteudo">
      <section class="hero wrap" id="inicio" aria-labelledby="titulo">
        <div class="hero-copy">
          <p class="eyebrow">
            <span></span> UBERPEIXES ORNAMENTAIS
          </p>
          <h1 id="titulo">
            Um pequeno
            <br />
            universo.
            <br />
            <em>Infinitas descobertas.</em>
          </h1>
          <p class="intro">
            Existe um mundo de cores, movimento e vida para conhecer. Entre no
            universo dos peixes ornamentais com a Uberpeixes.
          </p>
          <a
            class="button"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Fale com a gente{" "}
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
          <a class="text-link" href="#sobre">
            Conheça a loja <span aria-hidden="true">↓</span>
          </a>
        </div>
        <figure class="storefront">
          <Image
            src={entrance}
            alt="Entrada da Uberpeixes Ornamentais, com bandeira azul e a logomarca do peixe laranja ao lado da porta"
            class="storefront-photo"
            widths={[375, 640, 960, 1345]}
            sizes="(max-width: 640px) calc(100vw - 40px), (max-width: 950px) 45vw, 580px"
            width={1345}
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="storefront-caption">
            <span>NOSSA LOJA</span>
            <strong>Uberpeixes Ornamentais</strong>
          </figcaption>
        </figure>
        <div class="hero-bottom">
          <span>Natureza que inspira a olhar de perto.</span>
          <span aria-hidden="true">01 / DESCUBRA</span>
        </div>
      </section>
      <section
        class="about section wrap"
        id="sobre"
        aria-labelledby="sobre-titulo"
      >
        <div>
          <p class="eyebrow">01 — A LOJA</p>
          <h2 id="sobre-titulo">
            Prazer,
            <br />
            somos a <em>Uberpeixes.</em>
          </h2>
        </div>
        <div class="about-copy">
          <p class="large-copy">
            Um convite para conhecer de perto o universo dos peixes ornamentais.
          </p>
          <p>
            Este é o nosso espaço para apresentar a Uberpeixes Ornamentais e
            aproximar você da loja. Para saber sobre disponibilidade, valores e
            atendimento, converse diretamente com a gente.
          </p>
          <a
            class="underlined"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Tire suas dúvidas pelo WhatsApp{" "}
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
        </div>
      </section>
      <section
        class="gallery-section"
        id="galeria"
        aria-labelledby="galeria-titulo"
      >
        <div class="wrap section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">02 — NOSSO UNIVERSO</p>
              <h2 id="galeria-titulo">
                Cada detalhe,
                <br />
                <em>uma nova descoberta.</em>
              </h2>
            </div>
            <a
              class="underlined"
              href={instagram}
              target="_blank"
              rel="noopener noreferrer"
            >
              Acompanhe no Instagram <Arrow />
            </a>
          </div>
          <div class="gallery">
            <div class="photo-placeholder photo-tall">
              <span class="placeholder-icon" aria-hidden="true">
                ＋
              </span>
              <span>
                Peixes ornamentais
                <small>Espaço reservado para fotografia</small>
              </span>
            </div>
            <div class="photo-placeholder photo-light">
              <span class="placeholder-icon" aria-hidden="true">
                ＋
              </span>
              <span>
                Um pouco da loja<small>Espaço reservado para fotografia</small>
              </span>
            </div>
            <div class="photo-placeholder photo-indigo">
              <span class="placeholder-icon" aria-hidden="true">
                ＋
              </span>
              <span>
                Detalhes que encantam
                <small>Espaço reservado para fotografia</small>
              </span>
            </div>
          </div>
          <p class="gallery-note">
            Enquanto as fotos chegam por aqui, conheça nossas publicações em{" "}
            <a href={instagram} target="_blank" rel="noopener noreferrer">
              @uberpeixesornamentais <Arrow />
            </a>
          </p>
        </div>
      </section>
      <section
        class="section wrap visit"
        id="visite"
        aria-labelledby="visite-titulo"
      >
        <div>
          <p class="eyebrow">03 — ENCONTRE A GENTE</p>
          <h2 id="visite-titulo">
            A próxima descoberta
            <br />
            começa com um <em>olá.</em>
          </h2>
          <p>
            Fale com a loja para combinar sua visita e confirmar endereço e
            horário de atendimento.
          </p>
          <a
            class="button"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Conversar no WhatsApp <Arrow />
          </a>
        </div>
        <div class="contact-cards">
          <a href={instagram} target="_blank" rel="noopener noreferrer">
            <span>
              ACOMPANHE<b>Nosso Instagram</b>
              <small>@uberpeixesornamentais</small>
            </span>
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
          <a href={maps} target="_blank" rel="noopener noreferrer">
            <span>
              LOCALIZAÇÃO<b>Encontre a Uberpeixes</b>
              <small>Ver a loja no Google Maps</small>
            </span>
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
          <a href={maps} target="_blank" rel="noopener noreferrer">
            <span>
              AVALIAÇÕES REAIS<b>O que dizem no Google</b>
              <small>Abra o perfil e consulte a aba Avaliações</small>
            </span>
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
        </div>
      </section>
      <section class="closing">
        <div class="wrap">
          <p>Vamos descobrir esse universo juntos?</p>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer">
            Diga olá.{" "}
            <span aria-hidden="true">
              <Arrow />
            </span>
          </a>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <div class="brand footer-brand">
        <Brand />
      </div>
      <p>Uberpeixes Ornamentais</p>
      <p>Desenvolvido por Brendow Rodrigues</p>
    </footer>
  </body>
</html>
