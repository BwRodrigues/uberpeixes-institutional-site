---
import type { Species, LicensedPhoto } from "../../data/species-schema";
interface Props {
  animal: Species;
  eager?: boolean;
  zoom?: boolean;
  photo?: LicensedPhoto;
}
const { animal, eager = false, zoom = false } = Astro.props;
const photo = Astro.props.photo ?? animal.photo;
---

{photo ? (
  <figure class="species-photo">
    <a
      href={zoom ? photo.src : `/especies/${animal.slug}/`}
      target={zoom ? "_blank" : undefined}
      rel={zoom ? "noopener noreferrer" : undefined}
      aria-label={
        zoom ? `Abrir fotografia: ${photo.alt}` : `Ver ficha de ${animal.name}`
      }
    >
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </a>
    <figcaption>
      Foto: {photo.author} ·{" "}
      <a href={photo.sourceUrl} target="_blank" rel="noopener noreferrer">
        Origem
      </a>{" "}
      ·{" "}
      <a href={photo.licenseUrl} target="_blank" rel="noopener noreferrer">
        {photo.license}
      </a>
      {photo.note && <strong class="photo-note">{photo.note}</strong>}
    </figcaption>
  </figure>
) : (
  <div
    class="species-photo-pending"
    role="img"
    aria-label={`Fotografia autorizada de ${animal.name} pendente`}
  >
    <span>Fotografia autorizada pendente</span>
    <small>{animal.name}</small>
  </div>
)}
