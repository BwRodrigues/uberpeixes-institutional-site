---
import SpeciesLayout from "../../layouts/SpeciesLayout.astro";
import SpeciesPhoto from "./SpeciesPhoto.astro";
import { profileSections, type Species } from "../../data/species-schema";
import { scientificLabel, isPublishable } from "../../data/species";
import { canonicalUrl, speciesInquiry } from "../../config/site";
import SpeciesRecommendations from "./SpeciesRecommendations.astro";
interface Props {
  animal: Species;
}
const { animal } = Astro.props;
const path = `/especies/${animal.slug}/`;
const inquiry = speciesInquiry(animal.name, animal.scientificName);
const reviewed = isPublishable(animal);
const referenceLabels: Record<string, string> = {
  cof: "Taxonomia",
  class: "Classificação",
  care: "Cuidados",
  revision: "Revisão científica",
  fb: "Biologia",
  gbif: "Biodiversidade",
};
const essentialLabels = {
  temperature: "Temperatura recomendada",
  ph: "pH",
  gh: "Dureza (GH)",
  size: "Tamanho adulto",
  volume: "Volume recomendado",
  behavior: "Comportamento",
  sociability: "Sociabilidade",
  diet: "Alimentação",
  difficulty: "Nível de dificuldade",
};
const extraSections = [
  { id: "fotos", title: "Galeria de fotos" },
  { id: "relacionadas", title: "Espécies relacionadas" },
  { id: "referencias", title: "Referências bibliográficas" },
];
const structuredData: unknown[] = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Início",
        item: canonicalUrl("/"),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Espécies",
        item: canonicalUrl("/especies/"),
      },
      {
        "@type": "ListItem",
        position: 3,
        name: animal.name,
        item: canonicalUrl(path),
      },
    ],
  },
];
if (
  animal.references.length &&
  animal.sections.some((section) => section.fields.length)
)
  structuredData.push({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: `${animal.name} — ${scientificLabel(animal)}`,
    description: animal.description,
    image: animal.photo
      ? [animal.photo, ...animal.additionalPhotos].map((photo) =>
          canonicalUrl(photo.src),
        )
      : undefined,
    mainEntityOfPage: canonicalUrl(path),
  });
---

<SpeciesLayout
  title={`${animal.name} (${scientificLabel(animal)}) | Uberpeixes`}
  description={animal.description}
  path={path}
  draft={!reviewed}
  image={animal.photo?.src}
  structuredData={structuredData}
>
  <nav class="breadcrumbs" aria-label="Caminho de navegação">
    <a href="/">Início</a>
    <span aria-hidden="true">/</span>
    <a href="/especies/">Espécies</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{animal.name}</span>
  </nav>
  <section class="species-hero">
    <div>
      <p class="eyebrow">{animal.category}</p>
      <h1>{animal.name}</h1>
      <p class="scientific-name">
        <i>{scientificLabel(animal)}</i>
      </p>
      <p>{animal.description}</p>
      <a
        class="button"
        href={inquiry}
        target="_blank"
        rel="noopener noreferrer"
      >
        Consultar no WhatsApp
      </a>
      <a class="back-link" href="/especies/">
        Voltar ao catálogo
      </a>
    </div>
    <SpeciesPhoto animal={animal} eager zoom />
  </section>
  <div class="profile-layout">
    <nav class="profile-index" aria-label="Seções da ficha">
      <details class="profile-navigation" open>
        <summary>Nesta ficha</summary>
        <ul>
          {profileSections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))}
          {extraSections.map((section) => (
            <li>
              <a href={`#${section.id}`}>{section.title}</a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
    <div class="profile-sections">
      {profileSections.map((definition) => {
        const data = animal.sections.find(
          (section) => section.id === definition.id,
        );
        return (
          <>
            <details
              class="profile-section"
              id={definition.id}
              open={
                Boolean(data?.fields.length) &&
                ["apresentacao", "agua", "criacao"].includes(definition.id)
              }
            >
              <summary>
                <h2>{definition.title}</h2>
              </summary>
              {data?.fields.length ? (
                <div class="profile-fields">
                  {data.fields.map((field) => (
                    <section class="profile-field">
                      <h3>{field.label}</h3>
                      <p class="profile-field-value">
                        {field.value}
                        <span class="field-references">
                          <span>Fontes:</span>
                          {field.referenceIds.map((id) => (
                            <a
                              href={`#fonte-${id}`}
                              title={
                                animal.references.find(
                                  (reference) => reference.id === id,
                                )?.title
                              }
                            >
                              {referenceLabels[id] ?? "Referência científica"}
                            </a>
                          ))}
                        </span>
                      </p>
                    </section>
                  ))}
                </div>
              ) : null}
            </details>
            {definition.id === "apresentacao" && (
              <section
                class="species-essentials"
                aria-labelledby="essentials-title"
              >
                <h2 id="essentials-title">Informações essenciais</h2>
                <dl>
                  {(animal.essentials ?? []).map((fact) => (
                    <div data-essential={fact.key}>
                      <dt>{essentialLabels[fact.key]}</dt>
                      <dd>{fact.value}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )}
          </>
        );
      })}
      {animal.additionalPhotos.length > 0 && (
        <section
          class="species-gallery"
          id="fotos"
          aria-labelledby="species-gallery-title"
        >
          <h2 id="species-gallery-title">Galeria de fotos</h2>
          <p>
            Veja outros registros de <i>{animal.scientificName}</i>. Toque em
            uma foto para abrir a imagem completa.
          </p>
          <div class="species-gallery-grid">
            {animal.additionalPhotos.map((photo) => (
              <SpeciesPhoto animal={animal} photo={photo} zoom />
            ))}
          </div>
        </section>
      )}
      <SpeciesRecommendations animal={animal} />
      <section id="referencias" class="profile-references">
        <h2>Referências bibliográficas</h2>
        {animal.references.length ? (
          <ol>
            {animal.references.map((reference) => (
              <li id={`fonte-${reference.id}`}>
                {reference.author && <span>{reference.author}. </span>}
                <a
                  href={reference.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {reference.title}
                </a>
                {reference.year && <span> ({reference.year})</span>}
                <small>Consultado em {reference.accessedAt}.</small>
              </li>
            ))}
          </ol>
        ) : null}
      </section>
    </div>
  </div>
  <aside class="species-inquiry">
    <span>Dúvidas sobre {animal.name}?</span>
    <a class="button" href={inquiry} target="_blank" rel="noopener noreferrer">
      Consultar no WhatsApp
    </a>
  </aside>
</SpeciesLayout>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(
    ".profile-navigation",
  );
  if (menu && matchMedia("(max-width: 699px)").matches) menu.open = false;
  const inquiryBar = document.querySelector<HTMLElement>(".species-inquiry");
  if (inquiryBar && "ResizeObserver" in window) {
    new ResizeObserver(() =>
      document.documentElement.style.setProperty(
        "--inquiry-height",
        `${inquiryBar.getBoundingClientRect().height}px`,
      ),
    ).observe(inquiryBar);
  }
  // Enhance section links only; all scientific content is already in the HTML.
  const revealSection = (hash: string, focus = false) => {
    let id: string;
    try {
      id = decodeURIComponent(hash.slice(1));
    } catch {
      return;
    }
    const target = document.getElementById(id);
    const details =
      target instanceof HTMLDetailsElement
        ? target
        : target?.closest("details");
    if (details instanceof HTMLDetailsElement) {
      details.open = true;
      if (focus)
        details.querySelector("summary")?.focus({ preventScroll: true });
    }
  };
  document
    .querySelectorAll<HTMLAnchorElement>(".profile-index a")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
          return;
        revealSection(link.hash);
        // Native fragment navigation can move focus after the click handler.
        requestAnimationFrame(() => revealSection(link.hash, true));
      });
    });
  window.addEventListener("hashchange", () => revealSection(location.hash));
  revealSection(location.hash);
</script>
