---
import { Image } from "astro:assets";
import logo from "../assets/logo-oficial.png";
interface Props {
  decorative?: boolean;
  loading?: "eager" | "lazy";
  size?: number;
}
const { decorative = false, loading = "eager", size = 336 } = Astro.props;
---

<Image
  src={logo}
  alt={decorative ? "" : "Uberpeixes — peixes ornamentais"}
  width={size}
  class="brand-logo"
  format="webp"
  quality={90}
  loading={loading}
  decoding="async"
/>
